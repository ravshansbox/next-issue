{
  "name": "next-issue",
  "version": "0.0.0",
  "description": "Autonomous issue harness driven by the Claude Agent SDK",
  "keywords": [
    "github",
    "issues",
    "agent",
    "claude",
    "automation",
    "cli"
  ],
  "homepage": "https://github.com/ravshansbox/next-issue/tree/main/packages/next-issue#readme",
  "bugs": "https://github.com/ravshansbox/next-issue/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravshansbox/next-issue.git",
    "directory": "packages/next-issue"
  },
  "license": "MIT",
  "author": "ravshansbox",
  "type": "module",
  "bin": {
    "next-issue": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json",
    "start": "node src/cli.mts",
    "test": "node --test \"test/**/*.test.mts\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --check",
    "format:fix": "oxfmt",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "ws": "^8.23.0"
  }
}
