{
  "name": "next-issue",
  "version": "0.0.0",
  "description": "Autonomous issue harness driven by the pi SDK",
  "keywords": [
    "github",
    "issues",
    "agent",
    "pi",
    "automation",
    "cli"
  ],
  "homepage": "https://github.com/ravshansbox/next-issue/tree/main/packages/next-issue#readme",
  "bugs": "https://github.com/ravshansbox/next-issue/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravshansbox/next-issue.git",
    "directory": "packages/next-issue"
  },
  "license": "MIT",
  "author": "ravshansbox",
  "type": "module",
  "bin": {
    "next-issue": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node src/cli.mts",
    "test": "node --test \"test/**/*.test.mts\"",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.5.0",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.0",
    "typebox": "^1.4.3",
    "ws": "^8.22.1"
  }
}
