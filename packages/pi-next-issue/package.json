{
  "name": "@ravshansbox/pi-next-issue",
  "version": "0.0.0",
  "description": "Pi extension that works through GitHub issues with the next-issue worker",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ravshansbox/pi-next-issue.git"
  },
  "homepage": "https://github.com/ravshansbox/pi-next-issue#readme",
  "bugs": {
    "url": "https://github.com/ravshansbox/pi-next-issue/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "github",
    "issues"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "node --test \"test/*.test.ts\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2"
  },
  "files": [
    "index.ts",
    "src"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "ws": "^8.22.1"
  }
}
